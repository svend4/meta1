{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://continuum.dev/schemas/repair-response.json",
  "title": "RepairResponse",
  "description": "Response from the LLM Repair Compiler containing the repaired plan and mutation log",
  "type": "object",
  "properties": {
    "repaired_plan": {
      "$ref": "execution-plan.json"
    },
    "mutations_applied": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["update_version", "modify_content", "modify_command", "update_assertion"]
          },
          "step_id": { "type": "string" },
          "description": { "type": "string" },
          "before_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "after_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "required": ["type", "step_id", "description", "before_hash", "after_hash"]
      }
    },
    "repair_signature": {
      "type": "object",
      "properties": {
        "planner_model": { "type": "string" },
        "planner_version": { "type": "string" },
        "system_prompt_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "generated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["planner_model", "system_prompt_hash", "generated_at"]
    }
  },
  "required": ["repaired_plan", "mutations_applied", "repair_signature"]
}
