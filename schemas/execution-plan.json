{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://continuum.dev/schemas/execution-plan.json",
  "title": "ExecutionPlan",
  "description": "A deterministic execution plan consisting of sequential steps. Can be generated by an LLM or written manually.",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this plan"
    },
    "version": {
      "type": "string",
      "enum": ["2.1", "3.0"],
      "description": "Schema version. Absent = 2.1 for backward compatibility."
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what this plan accomplishes"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of steps to execute sequentially",
      "items": {
        "$ref": "#/definitions/Step"
      }
    },
    "planner_signature": {
      "type": "object",
      "description": "Identity of the planning system. Present when LLM generated the plan. Absent for manual plans.",
      "properties": {
        "planner_model": {
          "type": "string",
          "description": "Model identifier used for planning (e.g. claude-sonnet-4-20250514)"
        },
        "planner_version": {
          "type": "string",
          "description": "Version string from the API response if available"
        },
        "system_prompt_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Hash of the system prompt used. If this changes, plans may differ."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["planner_model", "system_prompt_hash", "generated_at"]
    },
    "assertions": {
      "type": "array",
      "description": "Semantic correctness checks (v3.0). Optional — absent in v2.1 plans.",
      "items": {
        "$ref": "assertion.json"
      }
    },
    "protected_surface": {
      "$ref": "protected-surface.json",
      "description": "Defines which artifacts require strict integrity vs allow benign drift (v3.0)"
    },
    "lineage": {
      "$ref": "plan-lineage.json",
      "description": "Generational history of this plan (v3.0)"
    },
    "plan_signature": {
      "$ref": "plan-signature.json",
      "description": "I/O contract — what this plan expects and produces (v3.0, informational)"
    }
  },
  "required": ["plan_id", "steps"],
  "definitions": {
    "Step": {
      "type": "object",
      "description": "A single execution step",
      "oneOf": [
        { "$ref": "#/definitions/CreateFileStep" },
        { "$ref": "#/definitions/RunCommandStep" }
      ]
    },
    "CreateFileStep": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "description": "Unique identifier for this step within the plan"
        },
        "type": {
          "type": "string",
          "const": "create_file"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this step"
        },
        "path": {
          "type": "string",
          "description": "Relative file path to create (e.g. 'src/index.js')"
        },
        "content": {
          "type": "string",
          "description": "Exact file content to write"
        },
        "determinism": {
          "type": "string",
          "const": "guaranteed",
          "description": "File creation is always deterministic"
        }
      },
      "required": ["step_id", "type", "description", "path", "content", "determinism"]
    },
    "RunCommandStep": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "description": "Unique identifier for this step within the plan"
        },
        "type": {
          "type": "string",
          "const": "run_command"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of this step"
        },
        "command": {
          "type": "string",
          "description": "The command to execute (e.g. 'npm')"
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Command arguments (e.g. ['install', '--save-exact'])"
        },
        "determinism": {
          "type": "string",
          "enum": ["guaranteed", "best_effort"],
          "description": "Whether this command produces deterministic output"
        }
      },
      "required": ["step_id", "type", "description", "command", "args", "determinism"]
    }
  }
}
