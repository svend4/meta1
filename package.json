{
  "name": "continuum-runtime",
  "author": "Aleksandr Mikhailishin",
  "license": "MIT",
  "version": "3.0.0",
  "description": "Cognitive artifact ledger with semantic assertions, drift detection, and self-healing repair cascade. Run once, verify forever.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "continuum": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-types": "node scripts/generate-types.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "deterministic",
    "runtime",
    "replay",
    "execution-plan",
    "llm",
    "sandbox",
    "docker"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canonicalize": "^2.0.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dockerode": "^4.0.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
